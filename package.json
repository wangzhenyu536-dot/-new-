{
  "name": "evertrace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/shared",
    "functions"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @evertrace/web",
    "build": "npm run build:functions && npm run build --workspace @evertrace/web",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p tsconfig.tests.json && npm run typecheck --workspace @evertrace/functions",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "test:rules": "node scripts/emulators.mjs exec",
    "test:e2e": "node scripts/emulators.mjs e2e",
    "verify": "npm run typecheck && npm run lint && npm run test:rules && npm run test:e2e && npm run build",
    "emulators": "node scripts/emulators.mjs start",
    "setup:java": "node scripts/setup-java.mjs",
    "baseline": "node scripts/capture-baseline.mjs",
    "pretest:e2e": "node scripts/ensure-baseline.mjs",
    "build:functions": "npm run build --workspace @evertrace/functions",
    "test:integration": "node scripts/emulators.mjs exec",
    "admin:init": "node scripts/init-admin.mjs"
  },
  "devDependencies": {
    "node": "22.23.3",
    "typescript": "5.9.3",
    "eslint": "9.39.4",
    "typescript-eslint": "8.71.0",
    "@eslint/js": "9.39.4",
    "@types/node": "22.20.5",
    "@playwright/test": "1.63.0",
    "vitest": "5.0.3",
    "firebase-tools": "15.32.1",
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0"
  }
}
