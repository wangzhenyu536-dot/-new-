{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "tests/**/*.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "vitest.spark.config.ts",
    "playwright.spark.config.ts",
    "vitest.spark-s1.config.ts",
    "vitest.spark-s2.config.ts"
  ]
}
