# Local demo only; no cloud account or billing required.
VITE_FIREBASE_PROJECT_ID=demo-evertrace
VITE_USE_EMULATORS=true
# Optional port overrides. Automated tests use a separate config and project.
VITE_AUTH_EMULATOR_PORT=9099
VITE_FIRESTORE_EMULATOR_PORT=8080
VITE_FUNCTIONS_EMULATOR_PORT=5001

# Shared region: set matching FUNCTIONS_REGION for the deployed server functions.
VITE_FUNCTIONS_REGION=us-central1
VITE_STORAGE_EMULATOR_PORT=9199
# Cloud mode (only after a real Firebase Web app is configured):
# VITE_USE_EMULATORS=false
# VITE_FIREBASE_PROJECT_ID=your-project
# VITE_FIREBASE_API_KEY=your-public-web-api-key
# VITE_FIREBASE_AUTH_DOMAIN=your-authorized-auth-domain
# VITE_FIREBASE_STORAGE_BUCKET=your-actual-bucket-name
# VITE_FIREBASE_APP_ID=your-web-app-id

# Server Functions environment (functions/.env.<project-id>, not a VITE variable):
# FUNCTIONS_REGION=us-central1
# EVERTRACE_STORAGE_BUCKET=your-actual-bucket-name
# Omit EVERTRACE_STORAGE_BUCKET to use the official Firebase Admin default bucket.
