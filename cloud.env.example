# Copy to .env.cloud.local. This file is separate from local preview configuration.
# Use the Web app settings from Firebase; do not copy passwords or private keys here.
VITE_USE_EMULATORS=false
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=copy-exact-storage-bucket
VITE_FIREBASE_APP_ID=your-web-app-id
VITE_FUNCTIONS_REGION=us-central1
FUNCTIONS_REGION=us-central1
# Optional additional HTTPS domains, comma separated (no slash or path).
# EVERTRACE_SITE_ORIGINS=https://example.com
