# Spark-only production Web configuration. Copy to .env.spark.local.
# These are public Firebase Web app identifiers; never put service account keys here.
VITE_DATA_BACKEND=spark
VITE_USE_EMULATORS=false
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_API_KEY=your-public-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_APP_ID=your-web-app-id
